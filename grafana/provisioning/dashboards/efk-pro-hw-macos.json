      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki_efk_pro"
          },
          "expr": "(sum(count_over_time({job=\"efk-pro\", type=\"event\", name=\"hw_info\", os=\"macos\", build=~\"$build\"} | json | ramMb <= 8192 [$__range])) or vector(0)) / sum(count_over_time({job=\"efk-pro\", type=\"event\", name=\"hw_info\", os=\"macos\", build=~\"$build\"}[$__range]))",
          "legendFormat": "ratio",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "displayName": "ratio",
