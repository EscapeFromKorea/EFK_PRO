{
  "id": null,
  "uid": "efk-pro-hw-macos",
  "title": "EFK-PRO HW 부하 (macOS)",
  "description": "플레이어 PC(macOS)의 FPS/CPU·GPU 프레임타임/메모리. Unity는 사용률(%)을 주지 않아 프레임타임을 부하 지표로 쓴다.",
  "tags": [
    "efk-pro",
    "loki",
    "hw",
    "macos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "build",
        "label": "빌드 종류",
        "type": "custom",
        "query": "player,editor",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "player",
          "value": "player"
        },
        "options": [
          {
            "selected": false,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": true,
            "text": "player",
            "value": "player"
          },
          {
            "selected": false,
            "text": "editor",
            "value": "editor"
          }
        ]
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "EFK-PRO 대시보드",
      "tags": [
        "efk-pro"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "수집된 세션 수",
      "description": "hw_info 이벤트 수 = 세션 시작 횟수(선택 시간 범위).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki_efk_pro"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki_efk_pro"
          },
          "expr": "sum(count_over_time({job=\"efk-pro\", type=\"event\", name=\"hw_info\", os=\"macos\", build=~\"$build\"}[$__range])) or vector(0)",
          "legendFormat": "sessions",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "displayName": "sessions"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "평균 FPS",
      "description": "5초 윈도우 FPS의 평균. 30 미만 빨강 / 55 미만 노랑.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki_efk_pro"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki_efk_pro"
          },
          "expr": "avg by (build) (avg_over_time({job=\"efk-pro\", type=\"metric\", name=\"fps\", os=\"macos\", build=~\"$build\"} | regexp \"(?P<v>.+)\" | unwrap v [$__range]))",
          "legendFormat": "{{build}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "green",
                "value": 55
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
