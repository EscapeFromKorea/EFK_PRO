          },
          "expr": "avg_over_time({job=\"efk-pro\", type=\"metric\", name=\"sys_mem_mb\", os=\"macos\", build=~\"$build\"} | regexp \"(?P<v>.+)\" | unwrap v [$__interval])",
          "legendFormat": "sys_mem ({{build}})"
